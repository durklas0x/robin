{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Pathlet",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-scheme",
        "Pathlet",
        "-configuration",
        "Debug",
        "-destination",
        "platform=macOS",
        "-derivedDataPath",
        "build",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "owner": "swift",
        "fileLocation": "autoDetect",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (warning|error): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Run Pathlet",
      "type": "shell",
      "command": "open",
      "args": [
        "${workspaceFolder}/build/Build/Products/Debug/Pathlet.app"
      ],
      "dependsOn": [
        "Build Pathlet"
      ],
      "problemMatcher": []
    },
    {
      "label": "Clean Pathlet",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-scheme",
        "Pathlet",
        "-derivedDataPath",
        "build",
        "clean"
      ],
      "problemMatcher": []
    },
    {
      "label": "Test Pathlet",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-project",
        "Pathlet.xcodeproj",
        "-scheme",
        "Pathlet",
        "-destination",
        "platform=macOS",
        "-derivedDataPath",
        "build",
        "test"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
