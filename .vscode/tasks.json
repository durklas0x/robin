{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Robin",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-scheme",
        "Robin",
        "-configuration",
        "Debug",
        "-destination",
        "platform=macOS",
        "-derivedDataPath",
        "build",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "owner": "swift",
        "fileLocation": "autoDetect",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (warning|error): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Run Robin",
      "type": "shell",
      "command": "open",
      "args": [
        "${workspaceFolder}/build/Build/Products/Debug/Robin.app"
      ],
      "dependsOn": [
        "Build Robin"
      ],
      "problemMatcher": []
    },
    {
      "label": "Clean Robin",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-scheme",
        "Robin",
        "-derivedDataPath",
        "build",
        "clean"
      ],
      "problemMatcher": []
    },
    {
      "label": "Test Robin",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-project",
        "Robin.xcodeproj",
        "-scheme",
        "Robin",
        "-destination",
        "platform=macOS",
        "-derivedDataPath",
        "build",
        "test"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
